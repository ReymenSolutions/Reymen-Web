---
import { SITE } from "../config";
---
<button id="chat-fab" type="button" aria-expanded="false" aria-controls="chat-box"><span class="chat-dot" aria-hidden="true"></span><svg class="chat-ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/></svg><span class="fab-label">Pregúntanos</span></button>
<div id="chat-box" role="dialog" aria-label="Chat con el asistente de Reymen" data-api={`${SITE.apiUrl}/api/public/chat`}>
  <div id="chat-head"><span>Asistente de Reymen</span><button type="button" id="chat-close" aria-label="Cerrar chat"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button></div>
  <div id="chat-log" aria-live="polite"></div>
  <form id="chat-form" autocomplete="off">
    <input id="chat-input" maxlength="500" placeholder="Escribe tu pregunta…" aria-label="Tu mensaje" spellcheck="true" />
    <button class="chat-send" type="submit">Enviar</button>
  </form>
</div>

<style is:global>
  #chat-fab { position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 60; display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.85rem 1.1rem; background: var(--ink); color: var(--white); border: 0; border-radius: 999px; font-weight: 650; font-stretch: 104%; font-size: 0.95rem; cursor: pointer; box-shadow: 0 12px 30px -10px rgb(10 22 51 / 0.55); transition: transform var(--t-fast) var(--ease), background-color var(--t-fast) var(--ease); }
  #chat-fab .chat-ico { display: none; }
  #chat-fab[data-hidden="true"] { opacity: 0; transform: translateY(12px); pointer-events: none; }
  #chat-fab { transition: transform var(--t-fast) var(--ease), background-color var(--t-fast) var(--ease), opacity var(--t-base) var(--ease); }
  #chat-fab:hover { background: #14244d; transform: translateY(-2px); }
  #chat-fab:active { transform: scale(0.97); }
  #chat-fab .chat-dot { position: relative; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: #5b7cff; }
  #chat-fab .chat-dot::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: #5b7cff; animation: chat-ring 2.8s var(--ease) 2; }
  @keyframes chat-ring { from { transform: scale(1); opacity: 0.6; } to { transform: scale(3); opacity: 0; } }
  #chat-box { position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: calc(max(1rem, env(safe-area-inset-bottom)) + 3.8rem); z-index: 60; width: min(24rem, 100vw - 2rem); height: min(32rem, 70vh); background: var(--white); color: var(--ink); border: 1px solid var(--mist); border-radius: var(--r-lg); display: none; flex-direction: column; overflow: hidden; box-shadow: var(--lift); overscroll-behavior: contain; }
  #chat-box.open { display: flex; animation: chat-in var(--t-base) var(--ease); transform-origin: bottom right; }
  @keyframes chat-in { from { opacity: 0; transform: translateY(8px) scale(0.98); } to { opacity: 1; transform: none; } }
  #chat-head { padding: 0.9rem 1rem; border-bottom: 1px solid var(--mist); font-weight: 700; font-stretch: 106%; display: flex; justify-content: space-between; align-items: center; background: var(--paper); }
  #chat-close { background: none; border: 0; cursor: pointer; padding: 0.4rem; border-radius: var(--r-sm); color: var(--ink-soft); }
  #chat-close:hover { color: var(--ink); background: color-mix(in srgb, var(--blue) 8%, transparent); }
  #chat-log { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.6rem; overscroll-behavior: contain; }
  .bubble { max-width: 85%; padding: 0.6rem 0.85rem; border-radius: 14px; font-size: 0.95rem; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; }
  .bubble.bot { background: #eef2fb; align-self: flex-start; border-bottom-left-radius: 4px; }
  .bubble.me { background: var(--blue); color: var(--white); align-self: flex-end; border-bottom-right-radius: 4px; }
  #chat-form { display: flex; gap: 0.5rem; padding: 0.7rem; border-top: 1px solid var(--mist); }
  #chat-form input { flex: 1; min-width: 0; padding: 0.65rem 0.8rem; border: 1.5px solid #b9c5e0; border-radius: var(--r-sm); background: var(--white); }
  #chat-form input:focus-visible { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px color-mix(in srgb, var(--blue) 28%, transparent); }
  .chat-send { background: var(--blue); color: var(--white); border: 0; border-radius: var(--r-sm); padding: 0 1rem; font-weight: 650; cursor: pointer; transition: background-color var(--t-fast) var(--ease); }
  .chat-send:hover { background: #1438d6; }
  .chat-send:disabled { opacity: 0.6; }
  @media (max-width: 36rem) {
    #chat-fab { width: 3.1rem; height: 3.1rem; padding: 0; justify-content: center; }
    #chat-fab .chat-dot { display: none; }
    #chat-fab .chat-ico { display: block; }
    #chat-fab .fab-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    #chat-box { right: 0.5rem; left: 0.5rem; width: auto; height: min(34rem, 72dvh); bottom: calc(max(1rem, env(safe-area-inset-bottom)) + 3.7rem); }
  }
</style>

<script>
  const fab = document.getElementById("chat-fab")!;
  const box = document.getElementById("chat-box")!;
  const log = document.getElementById("chat-log")!;
  const form = document.getElementById("chat-form") as HTMLFormElement;
  const input = document.getElementById("chat-input") as HTMLInputElement;
  const api = box.dataset.api!;
  let sid = "";
  try { sid = sessionStorage.getItem("reymen-chat") ?? ""; } catch {}
  if (!sid) {
    sid = (crypto.randomUUID?.() ?? String(Date.now()) + Math.random().toString(36).slice(2)).replace(/[^A-Za-z0-9_-]/g, "").padEnd(16, "x").slice(0, 40);
    try { sessionStorage.setItem("reymen-chat", sid); } catch {}
  }
  const add = (text: string, who: "bot" | "me") => {
    const b = document.createElement("div");
    b.className = `bubble ${who}`;
    b.textContent = text;
    log.appendChild(b);
    log.scrollTop = log.scrollHeight;
    return b;
  };
  let greeted = false;
  let handedOff = false;
  const open = (v: boolean) => {
    box.classList.toggle("open", v); sync();
    fab.setAttribute("aria-expanded", String(v));
    if (v) { (window as unknown as { plausible?: (n: string) => void }).plausible?.("Chat Abierto"); input.focus(); if (!greeted) { greeted = true; add("¡Hola! Soy el asistente de Reymen. Cuéntame de tu negocio y te explico cómo podemos ayudarte.", "bot"); } }
  };
  fab.addEventListener("click", () => open(!box.classList.contains("open")));
  // El botón flotante no debe tapar el formulario ni el pie: se oculta mientras están a la vista (salvo con el chat abierto).
  const cover = new Set<Element>();
  const sync = () => fab.setAttribute("data-hidden", String(cover.size > 0 && !box.classList.contains("open")));
  const io = new IntersectionObserver((entries) => { entries.forEach((e) => (e.isIntersecting ? cover.add(e.target) : cover.delete(e.target))); sync(); }, { threshold: 0.15 });
  document.querySelectorAll(".hero, #contacto, footer").forEach((el) => io.observe(el));
  document.getElementById("chat-close")!.addEventListener("click", () => open(false));
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text || handedOff) return;
    input.value = "";
    add(text, "me");
    const wait = add("…", "bot");
    try {
      const res = await fetch(api, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ sessionId: sid, message: text }) });
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      if (data.handoff) { handedOff = true; wait.textContent = data.notice ?? "Una persona del equipo te contactará."; input.disabled = true; location.hash = "contacto"; }
      else wait.textContent = data.reply;
    } catch {
      wait.textContent = "Ahora mismo no puedo responder. Déjanos tus datos en el formulario y te escribimos.";
    }
    log.scrollTop = log.scrollHeight;
  });
</script>
