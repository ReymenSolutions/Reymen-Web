---
// Lista de puntos con filete superior: encabezado en negrita y una frase. Sin tarjetas.
import StatusBadge from "./StatusBadge.astro";
// `inherit`: el estado que ya declara la página (por ejemplo, la etiqueta del encabezado); no se repite en cada punto.
interface Props { items: { h: string; p: string; status?: "live" | "beta" | "planned" | "concept" }[]; cols?: 2 | 3; inherit?: "live" | "beta" | "planned" | "concept" }
const { items, cols = 2, inherit } = Astro.props;
---
<div class="features" data-cols={cols}>
  {items.map((it) => <div><h3>{it.h}{it.status && it.status !== "live" && it.status !== inherit && <> <StatusBadge status={it.status} /></>}</h3><p>{it.p}</p></div>)}
</div>

<style>
  .features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s-8); }
  .features[data-cols="3"] { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--s-7); }
  .features div { padding: var(--s-5) 0 var(--s-6); border-top: 1px solid var(--mist); }
  h3 { margin-bottom: var(--s-2); }
  p { color: var(--ink-soft); }
  @media (max-width: 62rem) { .features, .features[data-cols="3"] { grid-template-columns: 1fr; } }
</style>
