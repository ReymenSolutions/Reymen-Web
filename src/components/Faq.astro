---
// Preguntas frecuentes con <details> nativo (teclado y lectores de pantalla gratis) y datos estructurados para buscadores.
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((i) => (
    <details>
      <summary>{i.q}</summary>
      <p>{i.a}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: items.map((i) => ({ "@type": "Question", name: i.q, acceptedAnswer: { "@type": "Answer", text: i.a } })) })} />

<style>
  .faq { border-top: 1px solid var(--mist); }
  details { border-bottom: 1px solid var(--mist); }
  summary { list-style: none; cursor: pointer; padding: var(--s-5) 0; display: flex; justify-content: space-between; gap: var(--s-5); align-items: baseline; font-weight: 650; font-stretch: 106%; font-size: var(--step-1); letter-spacing: -0.012em; transition: color var(--t-fast) var(--ease); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; flex: none; font-weight: 400; font-size: 1.6em; line-height: 0.8; color: var(--blue-ink); transition: transform var(--t-base) var(--ease); }
  details[open] summary::after { transform: rotate(45deg); }
  summary:hover { color: var(--blue-ink); }
  details p { padding-bottom: var(--s-5); color: var(--ink-soft); max-width: 60ch; }
</style>
