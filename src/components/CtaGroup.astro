---
// Par de llamadas a la acción. Calendly y WhatsApp son opcionales (src/config.ts): sin ellos, todo cae al formulario.
import { SITE, whatsappLink } from "../config";
import Button from "./Button.astro";
interface Props { size?: "md" | "lg"; secondaryLabel?: string }
const { size = "lg", secondaryLabel } = Astro.props;
const wa = whatsappLink();
const demo = SITE.calendlyUrl || "#contacto";
---
<div class="cta-group">
  <Button href={demo} size={size} event="CTA Demo" external={!!SITE.calendlyUrl}>Agendar demo</Button>
  {wa
    ? <Button href={wa} variant="ghost" size={size} event="CTA WhatsApp" external>Escribir por WhatsApp</Button>
    : <Button href="#contacto" variant="ghost" size={size}>{secondaryLabel ?? "Dejar mis datos"}</Button>}
</div>

<style>
  .cta-group { display: flex; flex-wrap: wrap; gap: var(--s-3); }
</style>
