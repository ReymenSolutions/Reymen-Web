---
// Glifos propios de Reymen: trazo uniforme sobre rejilla de 24 y un «nodo» relleno que es el punto de la marca.
// Hablan de conexión (nodos y líneas), automatización (flujo con retorno) e IA (nodos dentro de una conversación).
import { GLYPHS } from "../lib/glyphs";
interface Props { name: "agent" | "automation" | "software" | "restaurant" | "clinic" | "property" | "app" | "pos" | "card" | "crm" | "inbox" | "loyalty"; size?: number; class?: string }
const { name, size = 28, class: extra = "" } = Astro.props;
const g = GLYPHS;
---
<svg class:list={["glyph", extra]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={g[name]} />

<style>
  .glyph :global(.n) { fill: var(--glyph-node, var(--electric)); stroke: none; }
</style>
