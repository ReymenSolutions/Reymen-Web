---
// Captura real de Reymen App recortada a lo que explica, con marco de ventana. El recorte se acerca (zoom) a la zona de foco.
// Siempre es una captura con datos de demostración: lleva su leyenda.
import { focusVars } from "../lib/focus";
interface Props { name: string; alt: string; width: number; height: number; focus?: number[]; aspect?: string; label?: string; caption?: string; eager?: boolean }
const { name, alt, width, height, focus = [50, 50, 1], aspect = "16 / 10", label, caption = "Datos de demostración.", eager = false } = Astro.props;
---
<figure class="shot">
  <div class="win">
    <div class="bar" aria-hidden="true"><span class="lights"></span>{label && <span class="lbl">{label}</span>}</div>
    <div class="crop" style={`aspect-ratio:${aspect};${focusVars(focus)}`}>
      <img src={`/capturas/${name}.webp`} alt={alt} width={width} height={height} loading={eager ? "eager" : "lazy"} decoding="async" />
    </div>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .shot { margin: 0; display: grid; gap: var(--s-3); }
  .win { border-radius: 14px; overflow: hidden; background: var(--white); border: 1px solid var(--glass-line); box-shadow: var(--lift-night); }
  .bar { display: flex; align-items: center; gap: 0.7rem; padding: 0.45rem 0.8rem; background: #0e1b48; color: var(--on-night-soft); font-size: 0.78rem; font-weight: 600; font-stretch: 106%; }
  .lights { width: 2.6em; height: 0.62em; background: radial-gradient(circle at 0.31em 50%, #3a4a85 0.28em, transparent 0.3em), radial-gradient(circle at 1.3em 50%, #3a4a85 0.28em, transparent 0.3em), radial-gradient(circle at 2.3em 50%, #3a4a85 0.28em, transparent 0.3em); }
  .crop { position: relative; overflow: hidden; background: #e9eefb; }
  .crop img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top left; transform-origin: var(--ox, 0%) var(--oy, 0%); transform: scale(var(--z, 1)); }
  figcaption { color: var(--on-night-soft); font-size: var(--step--1); }
  :global(.tone-paper) figcaption, :global(.tone-white) figcaption { color: var(--ink-soft); }
</style>
