---
// Explorador de producto: una lista a la izquierda y la captura real a la derecha. Es un tablist accesible (flechas, Inicio, Fin).
import Window from "./Window.astro";
interface Item { id: string; name: string; summary: string; shot: "lealtad" | "inbox" | "inventario" | "pipeline"; alt: string; label: string; w: number; h: number }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<div class="explorer" data-explorer>
  <div class="tabs" role="tablist" aria-label="Productos de Reymen" aria-orientation="vertical">
    {items.map((it, i) => (
      <button class="tab" role="tab" id={`tab-${it.id}`} aria-controls={`panel-${it.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} type="button">
        <span class="name">{it.name}</span>
        <span class="summary">{it.summary}</span>
      </button>
    ))}
  </div>
  <div class="stage">
    {items.map((it, i) => (
      <div class="panel" role="tabpanel" id={`panel-${it.id}`} aria-labelledby={`tab-${it.id}`} hidden={i !== 0} tabindex="0">
        <Window name={it.shot} alt={it.alt} label={it.label} width={it.w} height={it.h} />
      </div>
    ))}
  </div>
</div>

<style>
  .explorer { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-7); align-items: start; }
  .tabs { display: grid; border-top: 1px solid var(--mist); position: sticky; top: 6rem; }
  .tab { text-align: left; background: none; border: 0; border-bottom: 1px solid var(--mist); padding: var(--s-4) 0 var(--s-4) var(--s-5); cursor: pointer; position: relative; color: var(--ink-soft); transition: color var(--t-base) var(--ease); }
  .tab::before { content: ""; position: absolute; left: 0; top: -1px; bottom: -1px; width: 3px; background: var(--blue); transform: scaleY(0); transform-origin: top; transition: transform var(--t-base) var(--ease); }
  .tab .name { display: block; font-weight: 700; font-stretch: 108%; font-size: var(--step-1); letter-spacing: -0.015em; color: var(--ink); }
  .tab .summary { display: none; max-width: 42ch; font-size: 0.97rem; line-height: 1.5; margin-top: var(--s-2); }
  .tab:hover { color: var(--ink); }
  .tab[aria-selected="true"] { color: var(--ink-soft); }
  .tab[aria-selected="true"]::before { transform: scaleY(1); }
  .tab[aria-selected="true"] .summary { display: block; animation: swap var(--t-base) var(--ease); }
  .stage { background: color-mix(in srgb, var(--blue) 7%, var(--paper)); border-radius: var(--r-lg); padding: clamp(0.75rem, 2vw, 1.75rem); aspect-ratio: 1500 / 1060; display: grid; place-items: center; }
  .panel { width: 100%; animation: swap var(--t-base) var(--ease); }
  .panel[hidden] { display: none; }
  @keyframes swap { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (max-width: 62rem) {
    .explorer { grid-template-columns: 1fr; gap: var(--s-5); }
    .tabs { position: static; display: flex; overflow-x: auto; border: 0; gap: var(--s-2); padding-bottom: var(--s-2); scrollbar-width: none; }
    .tab { flex: none; border: 1.5px solid var(--mist); border-radius: var(--r-md); padding: 0.7rem 1rem; background: var(--white); }
    .tab::before { display: none; }
    .tab .name { font-size: 0.95rem; }
    .tab .summary { display: none; }
    .tab[aria-selected="true"] { border-color: var(--blue); }
    .stage { aspect-ratio: auto; padding: var(--s-2); }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-explorer]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => { t.setAttribute("aria-selected", String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      panels.forEach((p, k) => { p.hidden = k !== i; });
      if (focus) tabs[i].focus();
      history.replaceState(null, "", `#producto-${tabs[i].id.replace("tab-", "")}`);
    };
    // Enlace directo a un producto: /#producto-lealtad
    const fromUrl = tabs.findIndex((t) => `#producto-${t.id.replace("tab-", "")}` === location.hash);
    if (fromUrl > 0) { select(fromUrl); root.closest("section")?.scrollIntoView(); }
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i));
      t.addEventListener("keydown", (e) => {
        const n = tabs.length; let to = -1;
        if (e.key === "ArrowDown" || e.key === "ArrowRight") to = (i + 1) % n;
        else if (e.key === "ArrowUp" || e.key === "ArrowLeft") to = (i - 1 + n) % n;
        else if (e.key === "Home") to = 0; else if (e.key === "End") to = n - 1;
        if (to >= 0) { e.preventDefault(); select(to, true); }
      });
    });
  });
</script>
