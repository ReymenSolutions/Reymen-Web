---
// Encabezado de sección: título con el punto de la marca y, si hay, una frase. El punto es azul (plataforma) o naranja (restaurante).
interface Props { id: string; title: string; lede?: string; dot?: "blue" | "ember"; level?: 2 | 3 }
const { id, title, lede, dot = "blue", level = 2 } = Astro.props;
const Tag = level === 3 ? "h3" : "h2";
---
<div class="head">
  <Tag id={id}>{title}<span class:list={[dot === "ember" ? "dot-ember" : "dot"]}>.</span></Tag>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</div>

<style>
  .head { display: grid; gap: var(--s-4); margin-bottom: var(--head-gap); max-width: 52rem; }
  h3 { font-size: var(--step-3); }
</style>
