---
// Servicios a la medida: una lista de capacidades y un diagrama de flujo que se ilumina según la elegida.
// Dos disposiciones del mismo grafo (horizontal en escritorio, vertical en móvil) para que el texto siempre se lea.
type N = { id: string; label: string; sub?: string; f: string[] };
const nodes: N[] = [
  { id: "wa", label: "WhatsApp", f: ["agentes"] },
  { id: "web", label: "Formulario web", f: ["agentes"] },
  { id: "mail", label: "Correo", f: ["agentes"] },
  { id: "ia", label: "Agente IA", sub: "con tus reglas", f: ["agentes", "auto"] },
  { id: "auto", label: "Automatización", sub: "avisos y reportes", f: ["auto", "software"] },
  { id: "crm", label: "CRM", f: ["auto", "software"] },
  { id: "sheet", label: "Hojas de cálculo", f: ["auto", "software"] },
  { id: "team", label: "Tu equipo", sub: "avisos", f: ["auto", "software"] },
  { id: "sw", label: "Tu software", sub: "web o móvil, a la medida", f: ["software"] },
];
const edges = [
  ["wa", "ia", "agentes"], ["web", "ia", "agentes"], ["mail", "ia", "agentes"],
  ["ia", "auto", "agentes auto"], ["auto", "crm", "auto"], ["auto", "sheet", "auto"], ["auto", "team", "auto"],
  ["sw", "auto", "software"], ["sw", "crm", "software"], ["sw", "team", "software"],
];
type P = { x: number; y: number; w: number; h: number };
const wide: Record<string, P> = {
  wa: { x: 8, y: 18, w: 150, h: 46 }, web: { x: 8, y: 94, w: 150, h: 46 }, mail: { x: 8, y: 170, w: 150, h: 46 },
  ia: { x: 245, y: 46, w: 160, h: 56 }, auto: { x: 245, y: 150, w: 160, h: 56 },
  crm: { x: 482, y: 18, w: 150, h: 46 }, sheet: { x: 482, y: 94, w: 150, h: 46 }, team: { x: 482, y: 170, w: 150, h: 46 },
  sw: { x: 150, y: 270, w: 340, h: 58 },
};
const tall: Record<string, P> = {
  wa: { x: 4, y: 8, w: 108, h: 42 }, web: { x: 126, y: 8, w: 108, h: 42 }, mail: { x: 248, y: 8, w: 108, h: 42 },
  ia: { x: 90, y: 104, w: 180, h: 54 }, auto: { x: 90, y: 200, w: 180, h: 54 },
  crm: { x: 4, y: 296, w: 108, h: 42 }, sheet: { x: 126, y: 296, w: 108, h: 42 }, team: { x: 248, y: 296, w: 108, h: 42 },
  sw: { x: 40, y: 392, w: 280, h: 56 },
};
const edgePath = (L: Record<string, P>, a: string, b: string, vertical: boolean) => {
  const A = L[a], B = L[b];
  if (!vertical) {
    const down = B.y > A.y + A.h; // software sube
    if (a === "sw") { const x1 = A.x + A.w / 2, y1 = A.y, x2 = B.x + (B.x > A.x ? 0 : B.w / 2), y2 = B.y + B.h / 2; return b === "auto" ? `M${x1} ${y1} V${B.y + B.h}` : `M${A.x + A.w} ${A.y + A.h / 2} C ${A.x + A.w + 40} ${A.y + A.h / 2}, ${x2 - 40} ${y2}, ${x2} ${y2}`; }
    void down;
    const x1 = A.x + A.w, y1 = A.y + A.h / 2, x2 = B.x, y2 = B.y + B.h / 2, c = (x2 - x1) / 2;
    return `M${x1} ${y1} C ${x1 + c} ${y1}, ${x2 - c} ${y2}, ${x2} ${y2}`;
  }
  const up = a === "sw";
  const x1 = A.x + A.w / 2, y1 = up ? A.y : A.y + A.h, x2 = B.x + B.w / 2, y2 = up ? B.y + B.h : B.y, c = (y2 - y1) / 2;
  return `M${x1} ${y1} C ${x1} ${y1 + c}, ${x2} ${y2 - c}, ${x2} ${y2}`;
};
const focuses = [
  { id: "agentes", name: "Agentes de IA a la medida", text: "Asistentes que responden con tus reglas, tu información y tu tono, y que pasan a una persona cuando importa." },
  { id: "auto", name: "Automatización", text: "Flujos que conectan WhatsApp, correo, hojas de cálculo y tu CRM, con avisos y reportes para tu equipo." },
  { id: "software", name: "Desarrollo de software", text: "Aplicaciones web y móviles hechas para tu operación, con la misma seguridad y respaldos que usamos en nuestros productos." },
];
---
<div class="canvas" data-canvas data-focus="agentes">
  <div class="picker" role="group" aria-label="Capacidades">
    {focuses.map((f, k) => (
      <button type="button" class="pick" data-f={f.id} aria-pressed={k === 0 ? "true" : "false"}>
        <span class="name">{f.name}</span>
        <span class="text">{f.text}</span>
      </button>
    ))}
  </div>

  <div class="diagrams" aria-hidden="true">
    {[{ k: "wide", L: wide, vb: "0 0 640 340", v: false }, { k: "tall", L: tall, vb: "0 0 360 456", v: true }].map(({ k, L, vb, v }) => (
      <svg class={`dg dg-${k}`} viewBox={vb} focusable="false">
        <g class="edges">
          {edges.map(([a, b, f]) => <path class:list={["e", ...f.split(" ").map((x) => `f-${x}`)]} d={edgePath(L, a, b, v)} />)}
        </g>
        <g class="nodes">
          {nodes.map((n) => (
            <g class:list={["n", ...n.f.map((x) => `f-${x}`)]} transform={`translate(${L[n.id].x} ${L[n.id].y})`}>
              <rect width={L[n.id].w} height={L[n.id].h} rx="10" />
              <text x={L[n.id].w / 2} y={n.sub ? L[n.id].h / 2 - 4 : L[n.id].h / 2 + 5} text-anchor="middle" class="t1">{n.label}</text>
              {n.sub && <text x={L[n.id].w / 2} y={L[n.id].h / 2 + 14} text-anchor="middle" class="t2">{n.sub}</text>}
            </g>
          ))}
        </g>
      </svg>
    ))}
  </div>
</div>

<style>
  .canvas { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-8); align-items: center; }
  .picker { display: grid; gap: 0; border-top: 1px solid var(--night-line); }
  .pick { text-align: left; background: none; border: 0; border-bottom: 1px solid var(--night-line); padding: var(--s-5) 0 var(--s-5) var(--s-5); cursor: pointer; color: var(--on-night-soft); position: relative; transition: color var(--t-base) var(--ease); }
  .pick::before { content: ""; position: absolute; left: 0; top: -1px; bottom: -1px; width: 3px; background: var(--electric); transform: scaleY(0); transform-origin: top; transition: transform var(--t-base) var(--ease); }
  .pick .name { display: block; font-weight: 700; font-stretch: 108%; font-size: var(--step-1); letter-spacing: -0.015em; color: var(--on-night); }
  .pick .text { display: none; margin-top: var(--s-2); max-width: 44ch; line-height: 1.5; }
  .pick:hover { color: var(--on-night); }
  .pick[aria-pressed="true"]::before { transform: scaleY(1); }
  .pick[aria-pressed="true"] .text { display: block; animation: in var(--t-base) var(--ease); }
  @keyframes in { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }
  .diagrams { background: var(--night-2); border: 1px solid var(--night-line); border-radius: var(--r-lg); padding: var(--s-5); box-shadow: var(--lift-night); }
  .dg { width: 100%; height: auto; overflow: visible; }
  .dg-tall { display: none; }
  .e { fill: none; stroke: #4660d8; stroke-width: 2; opacity: 0.22; transition: opacity var(--t-base) var(--ease); }
  .n rect { fill: #101e55; stroke: #2c3d86; stroke-width: 1.5; transition: fill var(--t-base) var(--ease), stroke var(--t-base) var(--ease); }
  .n { opacity: 0.3; transition: opacity var(--t-base) var(--ease); }
  .t1 { fill: #eaf0ff; font: 650 13.5px var(--font); font-stretch: 106%; }
  .t2 { fill: var(--on-night-soft); font: 450 11px var(--font); }
  [data-focus="agentes"] .e.f-agentes, [data-focus="auto"] .e.f-auto, [data-focus="software"] .e.f-software { opacity: 1; stroke: #8ea6ff; stroke-dasharray: 5 7; animation: flow 1.1s linear infinite; }
  [data-focus="agentes"] .n.f-agentes, [data-focus="auto"] .n.f-auto, [data-focus="software"] .n.f-software { opacity: 1; }
  [data-focus="agentes"] .n.f-agentes rect, [data-focus="auto"] .n.f-auto rect, [data-focus="software"] .n.f-software rect { stroke: #8ea6ff; fill: #14266b; }
  @keyframes flow { to { stroke-dashoffset: -24; } }
  @media (max-width: 62rem) {
    .canvas { grid-template-columns: 1fr; gap: var(--s-6); }
    .dg-wide { display: none; } .dg-tall { display: block; max-width: 24rem; margin-inline: auto; }
    .t1 { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { .e { animation: none !important; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-canvas]").forEach((root) => {
    const picks = [...root.querySelectorAll<HTMLButtonElement>(".pick")];
    picks.forEach((b) => b.addEventListener("click", () => {
      root.dataset.focus = b.dataset.f;
      picks.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    }));
  });
</script>
