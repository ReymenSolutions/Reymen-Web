---
// Marca tipográfica: «Reymen» en ancho extendido y el punto de la identidad.
interface Props { href?: string }
const { href = "/" } = Astro.props;
---
<a class="wordmark" href={href} aria-label="Reymen, inicio" translate="no">Reymen<span class="dot">.</span></a>

<style>
  .wordmark {
    font-weight: 800; font-stretch: 122%; font-size: 1.3rem; letter-spacing: -0.03em; line-height: 1;
    text-decoration: none; color: inherit; display: inline-block;
  }
  .wordmark .dot { transition: transform var(--t-base) var(--ease); display: inline-block; transform-origin: 50% 80%; }
  .wordmark:hover .dot { transform: translateY(-0.12em); }
</style>
