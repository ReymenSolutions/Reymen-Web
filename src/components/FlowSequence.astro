---
// La pieza memorable del sitio: una operación de punta a punta (mensaje → IA → CRM → cobro → inventario → lealtad).
// Se arma una sola vez al cargar; «Repetir» la reproduce a petición. Sin JS o con movimiento reducido se ve completa y quieta.
const events = [
  { t: "6:02 p. m.", src: "WhatsApp", tone: "blue", title: "Fernanda Ibarra", text: "Hola, ¿tienen mesa para 6 a las 3 pm?" },
  { t: "6:02 p. m.", src: "Agente IA", tone: "blue", title: "Responde en segundos", text: "Hoy abrimos de 8:00 a 21:00. Te anoto y una persona confirma tu mesa." },
  { t: "6:02 p. m.", src: "CRM", tone: "blue", title: "Contacto nuevo", text: "Fernanda Ibarra entra al seguimiento, con su conversación." },
  { t: "6:40 p. m.", src: "Punto de venta", tone: "ember", title: "Mesa 4 cobrada", text: "$842.00 con propina, dividido en 2 pagos." },
  { t: "6:40 p. m.", src: "Inventario", tone: "ember", title: "Leche entera, stock bajo", text: "Quedan 9 lt de un mínimo de 20. Aviso al encargado." },
  { t: "6:41 p. m.", src: "Lealtad", tone: "ember", title: "Sello 9 de 10", text: "A Luis Ángel le falta 1 visita para su bebida gratis." },
];
---
<section class="flow" aria-labelledby="flow-title" data-flow>
  <header>
    <h2 id="flow-title">Un sábado cualquiera, en un restaurante</h2>
    <button class="replay" type="button" data-replay>Repetir</button>
  </header>
  <ol class="stream">
    {events.map((e, i) => (
      <li class="ev" data-i={i} data-tone={e.tone}>
        <span class="pin" aria-hidden="true"></span>
        <div class="meta"><span class="src">{e.src}</span><time class="nums">{e.t}</time></div>
        <p class="title">{e.title}</p>
        <p class="text">{e.text}</p>
      </li>
    ))}
  </ol>
  <p class="note">Ejemplo ilustrativo con datos ficticios.</p>
</section>

<style>
  .flow { background: var(--night); color: var(--on-night); border-radius: var(--r-lg); padding: var(--s-5) var(--s-5) var(--s-4); box-shadow: var(--lift); border: 1px solid var(--night-line); }
  header { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-4); margin-bottom: var(--s-4); }
  .flow h2 { font-size: 1.05rem; font-stretch: 108%; letter-spacing: -0.005em; font-weight: 650; text-wrap: balance; }
  .replay { background: none; border: 1px solid var(--night-line); color: var(--on-night-soft); border-radius: var(--r-sm); padding: 0.3rem 0.7rem; font-size: var(--step--1); cursor: pointer; transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease); }
  .replay:hover { color: var(--on-night); border-color: var(--on-night-soft); }
  .replay[hidden] { display: none; }
  .stream { position: relative; display: grid; gap: var(--s-4); padding-left: 1.5rem; }
  .stream::before { content: ""; position: absolute; left: 0.31rem; top: 0.5rem; bottom: 0.5rem; width: 2px; background: var(--night-line); }
  .ev { position: relative; }
  .pin { position: absolute; left: -1.5rem; top: 0.35rem; width: 0.7rem; height: 0.7rem; border-radius: 50%; background: #5b7cff; box-shadow: 0 0 0 4px var(--night); }
  .ev[data-tone="ember"] .pin { background: var(--ember); }
  .meta { display: flex; gap: var(--s-3); align-items: baseline; font-size: var(--step--1); color: var(--on-night-soft); }
  .src { font-weight: 650; color: #9db2ff; font-stretch: 106%; }
  .ev[data-tone="ember"] .src { color: #ff9a5c; }
  .title { font-weight: 650; font-stretch: 104%; margin-top: 2px; }
  .text { color: var(--on-night-soft); font-size: 0.95rem; line-height: 1.5; max-width: 44ch; }
  .note { margin-top: var(--s-4); font-size: var(--step--1); color: var(--on-night-soft); opacity: 0.8; }

  /* Estado inicial solo cuando hay JS: sin él, todo queda visible. */
  .flow[data-armed="true"] .ev { opacity: 0; transform: translateY(10px); }
  .flow[data-armed="true"] .stream::before { transform-origin: top; transform: scaleY(0); }
  .flow[data-playing="true"] .stream::before { transform: scaleY(1); transition: transform 5200ms linear; }
  .flow[data-armed="true"] .ev.in { opacity: 1; transform: none; transition: opacity var(--t-slow) var(--ease), transform var(--t-slow) var(--ease); }
  .flow[data-armed="true"] .ev.in .pin { animation: pop 520ms var(--ease) both; }
  @keyframes pop { 0% { transform: scale(0.4); } 60% { transform: scale(1.35); } 100% { transform: scale(1); } }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-flow]");
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>(".ev")];
    const replay = root.querySelector<HTMLButtonElement>("[data-replay]")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timers: number[] = [];
    const reset = () => { timers.forEach(clearTimeout); timers = []; items.forEach((el) => el.classList.remove("in")); root.dataset.playing = "false"; };
    const play = () => {
      reset();
      void root.offsetWidth; // reinicia la línea de tiempo
      replay.hidden = true;
      root.dataset.playing = "true";
      items.forEach((el, i) => timers.push(window.setTimeout(() => el.classList.add("in"), 500 + i * 900)));
      timers.push(window.setTimeout(() => { replay.hidden = false; }, 500 + items.length * 900));
    };
    if (reduce) { replay.hidden = true; }
    else {
      root.dataset.armed = "true";
      replay.hidden = true;
      replay.addEventListener("click", play);
      // Arranca cuando la pieza entra en pantalla, una sola vez automáticamente.
      const io = new IntersectionObserver((entries) => { if (entries[0].isIntersecting) { io.disconnect(); play(); } }, { threshold: 0.35 });
      io.observe(root);
    }
  }
</script>
