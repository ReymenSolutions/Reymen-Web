---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import LeadForm from "../components/LeadForm.astro";

const faq = [
  { q: "¿Funciona para una sola sucursal y para varias?", a: "Para ambas. Cada sucursal lleva su inventario y sus ventas, y tú ves el total o el detalle." },
  { q: "¿Puedo imprimir tickets y comandas?", a: "Sí. Soportamos impresión de tickets desde el navegador y impresoras compatibles en Android; en la demo revisamos tu equipo." },
  { q: "¿Se conecta con Uber Eats, Rappi o DiDi?", a: "Los pedidos de plataformas de reparto pueden entrar a tu operación para verlos junto a tus ventas. Revisamos el detalle de cada plataforma en la demo." },
  { q: "¿Qué pasa si el inventario no está al día?", a: "Nunca bloquea una venta. El sistema te avisa y tú ajustas las existencias cuando puedas." },
  { q: "¿Cómo funciona la lealtad?", a: "Tus clientes guardan una tarjeta digital en su celular, acumulan sellos y canjean recompensas. Tú ves quién regresa y cuánto gasta." },
];
---
<Base title="Reymen para restaurantes y cafeterías · POS, inventario y lealtad" description="Punto de venta con mesas y cocina, inventario con recetas, programa de lealtad y asistente de WhatsApp para restaurantes y cafeterías en México." path="/restaurantes">
  <section class="hero">
    <div class="wrap grid g2" style="align-items:center">
      <div>
        <div class="eyebrow">Restaurantes y cafeterías</div>
        <h1>Que tu cocina, tu caja y tus clientes <span class="grad">hablen entre sí</span>.</h1>
        <p class="lead">Cobra rápido, controla tus insumos sin hojas de cálculo y haz que tus clientes regresen, con un asistente que contesta WhatsApp por ti.</p>
        <Cta />
      </div>
      <div class="mock" aria-label="Vista ilustrativa del punto de venta">
        <div class="bar"><i></i><i></i><i></i></div>
        <div class="body">
          <div class="kv"><span>Mesa 2</span><b>$420</b></div>
          <div class="kv"><span>Latte grande ×2</span><span class="pill">Listo</span></div>
          <div class="kv"><span>Baguette de pollo</span><span class="pill w">Cocina</span></div>
          <div class="kv"><span>Cobro dividido</span><span class="pill b">2 personas</span></div>
          <span class="muted" style="font-size:.78rem">Vista ilustrativa</span>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Lo que resuelve en tu restaurante</h2>
      <div class="grid g3" style="margin-top:28px">
        <div class="card"><div class="icon">🧾</div><h3>POS con mesas y cocina</h3><p>Pantalla de cocina (KDS), cobro dividido, propinas y corte de caja. Rápido en tableta o celular.</p></div>
        <div class="card"><div class="icon">🥬</div><h3>Inventario con recetas</h3><p>Cada platillo descuenta sus insumos solo. Ves costo por platillo, agotados y por agotarse.</p></div>
        <div class="card"><div class="icon">🛵</div><h3>Pedidos de reparto</h3><p>Tus pedidos de plataformas junto a tus ventas, en una sola vista.</p></div>
        <div class="card"><div class="icon">⭐</div><h3>Lealtad con tarjeta digital</h3><p>Sellos y recompensas, cumpleaños y avisos automáticos para que vuelvan.</p></div>
        <div class="card"><div class="icon">💬</div><h3>WhatsApp con IA</h3><p>Horarios, menú, reservas: contesta al instante y pasa a una persona lo que importa.</p></div>
        <div class="card"><div class="icon">📊</div><h3>Reportes del día</h3><p>Ventas por hora, producto estrella, ticket promedio y mermas, con el día de tu zona horaria.</p></div>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap" style="max-width:820px">
      <h2>Preguntas de restaurantes</h2>
      <Faq items={faq} />
    </div>
  </section>

  <section id="contacto">
    <div class="wrap grid g2">
      <div>
        <div class="eyebrow">Demo para tu restaurante</div>
        <h2>Veamos tu operación</h2>
        <p class="lead">Cuéntanos cuántas sucursales tienes y qué te quita más tiempo. Te mostramos cómo se vería en tu negocio.</p>
      </div>
      <div class="card"><LeadForm vertical="restaurantes" /></div>
    </div>
  </section>
</Base>
