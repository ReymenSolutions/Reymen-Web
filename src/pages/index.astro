---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import HeroStage from "../components/HeroStage.astro";
import Traces from "../components/Traces.astro";
import Glyph from "../components/Glyph.astro";
import StatusBadge from "../components/StatusBadge.astro";
import EcosystemShowcase from "../components/EcosystemShowcase.astro";
import EcosystemMap from "../components/EcosystemMap.astro";
import ServicesCanvas from "../components/ServicesCanvas.astro";
import Faq from "../components/Faq.astro";
import ContactSection from "../components/ContactSection.astro";
import Plans from "../components/Plans.astro";
import { SITE } from "../config";
import { homeContent, capabilities, services, products, productHref, interestVerticals, assertCatalogIntegrity, MODEL_LABEL } from "../lib/catalog";

// Todo el contenido sale de src/content (home.json, capabilities, products, services, verticals). Aquí solo está la composición.
await assertCatalogIntegrity();
const home = await homeContent();
const caps = await capabilities();
const prods = await products();
const svcs = await services();
const soon = await interestVerticals();
const demo = SITE.calendlyUrl || "/contacto";
const icons: Record<string, string> = {
  layers: '<path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="m3 13 9 5 9-5"/>',
  archive: '<path d="M4 8h16v11H4z"/><path d="m4 8 2-4h12l2 4"/><path d="M10 13h4"/>',
  shield: '<path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
};
const glyphOf = (g: string) => (g === "app" || g === "pos" || g === "card" ? "software" : g) as "software";
---
<Base darkHero title="Reymen Solutions · Software, agentes de IA y automatización" description="Reymen Solutions diseña software, agentes de IA y automatizaciones para negocios en México, y tiene un ecosistema propio de punto de venta, inventario, lealtad y mensajes para restaurantes.">
  <section class="hero tone-night" aria-labelledby="hero-title">
    <Traces />
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title">{home.hero.title}<span class="dot">.</span></h1>
        <p class="lede">{home.hero.lede}</p>
        <div class="cta-wrap"><div class="cta-row">
          <Button href={demo} size="lg" event="CTA Demo" external={!!SITE.calendlyUrl}>Agendar demo</Button>
          <Button href="/productos" variant="ghost" size="lg" event="Ver Ecosistema"><span class="l-full">Ver productos y soluciones</span><span class="l-short">Ver productos</span></Button>
        </div></div>
        <p class="tagline">{home.hero.tagline}</p>
        <dl class="facts">
          {home.facts.map((f) => <div><dt>{f.title}</dt><dd>{f.text}</dd></div>)}
        </dl>
      </div>
      <div class="hero-stage"><HeroStage /></div>
    </div>
  </section>

  <Section id="que-hacemos" tone="white" after="night" labelledby="que-title">
    <div class="head"><h2 id="que-title">Qué hacemos<span class="dot">.</span></h2></div>
    <div class="triad">
      {caps.map((c) => (
        <a class="cap" href={c.href}>
          <Glyph name={c.glyph} size={32} class="cap-glyph" />
          <h3>{c.title}</h3>
          <p>{c.text}</p>
        </a>
      ))}
    </div>
  </Section>

  <Section id="productos" labelledby="prod-title">
    <div class="head">
      <h2 id="prod-title">Productos propios<span class="dot">.</span></h2>
      <p class="lede">Se conectan entre sí. Unos se contratan por separado y otros son módulos de Reymen App.</p>
    </div>
    <ul class="rows">
      {prods.map((p) => (
        <li>
          <a class="row" href={productHref(p)}>
            <span class="r-name"><Glyph name={glyphOf(p.glyph)} size={30} class="r-glyph" />{p.name} <StatusBadge status={p.availability} /></span>
            <span class="r-text">{p.tagline}<span class="r-model">{MODEL_LABEL[p.model]}</span></span>
            <span class="r-cta">Conocer el producto</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="ecosistema" tone="night" labelledby="map-title">
    <div class="head">
      <h2 id="map-title">Un ecosistema conectado<span class="dot">.</span></h2>
      <p class="lede">Elige un recorrido para ver cómo se conectan las herramientas. Cada uno indica si ya está disponible, está en pruebas, en desarrollo o es un ejemplo.</p>
    </div>
    <EcosystemMap />
  </Section>

  <Section id="soluciones" tone="white" after="night" labelledby="sol-title">
    <div class="head"><h2 id="sol-title">Soluciones por industria<span class="dot">.</span></h2></div>
    <EcosystemShowcase />
    {soon.length > 0 && (
      <ul class="rows soon">
        {soon.map((v) => (
          <li>
            <a class="row" href={`/contacto?interes=${v.id}`}>
              <span class="r-name"><Glyph name={glyphOf(v.interest!.glyph)} size={30} class="r-glyph" />{v.name} <StatusBadge status={v.availability} /></span>
              <span class="r-text">{v.interest!.text}</span>
              <span class="r-cta">{v.interest!.cta}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <p class="other">¿Tu giro no está aquí? <a href="/contacto?interes=otra-industria">Cuéntanos qué necesitas</a> y lo revisamos juntos.</p>
  </Section>

  <Section id="servicios" tone="night" labelledby="servicios-title">
    <div class="head">
      <h2 id="servicios-title">Lo que no viene en caja, lo construimos contigo<span class="dot">.</span></h2>
      <p class="lede">Además de nuestros productos, desarrollamos a la medida sobre la misma base. Elige una capacidad y mira dónde entra en el flujo.</p>
    </div>
    <ServicesCanvas />
    <ul class="svc">
      {svcs.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}
    </ul>
    <div class="svc-cta"><Button href="/contacto?interes=servicios-a-medida" event="Servicios Proyecto">Cuéntanos tu proyecto</Button></div>
  </Section>

  <Section id="seguridad" tone="white" after="night" labelledby="seguridad-title">
    <div class="head"><h2 id="seguridad-title">Tus datos y los de tus clientes, protegidos<span class="dot">.</span></h2></div>
    <div class="trust">
      {home.trust.map((t) => (
        <div>
          <svg class="ico" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons[t.icon]} />
          <h3>{t.h}</h3>
          <p>{t.p}</p>
        </div>
      ))}
    </div>
    <p class="other">Así tratamos los datos personales: <a href="/privacidad">aviso de privacidad</a>.</p>
  </Section>

  {SITE.showPrices && <Plans />}

  <Section id="preguntas" labelledby="faq-title">
    <div class="faq-grid">
      <h2 id="faq-title">Preguntas frecuentes<span class="dot">.</span></h2>
      <Faq items={home.faq} />
    </div>
  </Section>

  <ContactSection />
</Base>

<style>
  /* Hero: noche con la luz del logo detrás del producto y un plano de líneas muy tenue (el «plano de operación») */
  .hero { position: relative; overflow: clip; padding-block: calc(4.25rem + clamp(1.5rem, 0.5rem + 3.4vw, 3.5rem)) clamp(3rem, 2rem + 3.5vw, 5.5rem); background: var(--night); color: var(--on-night); }
  .hero::before { content: ""; position: absolute; inset: -10% -5% 0 38%; background: radial-gradient(closest-side at 55% 45%, var(--bloom), transparent 72%); pointer-events: none; }
  .hero::after { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0.55;
    background-image: linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px); background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 70% 60% at 65% 40%, #000 20%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 65% 40%, #000 20%, transparent 75%); }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 4vw, 4.5rem); align-items: center; }
  .hero-copy { display: grid; gap: var(--s-6); justify-items: start; }
  .hero h1 { color: var(--white); font-size: clamp(1.65rem, 1rem + 2.1vw, 3rem); font-stretch: 106%; letter-spacing: -0.032em; }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .facts { display: grid; gap: var(--s-4); padding-top: var(--s-5); border-top: 1px solid var(--night-line); width: 100%; }
  .facts div { display: grid; gap: 0.1rem; }
  .facts dt { font-weight: 650; font-stretch: 104%; color: var(--on-night); }
  .facts dd { margin: 0; color: var(--on-night-soft); font-size: 0.95rem; }
  .tagline { margin: 0; color: var(--on-night-soft); font-weight: 600; font-stretch: 108%; letter-spacing: 0.01em; }
  .triad { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-7); }
  .cap { display: grid; gap: var(--s-3); align-content: start; padding-top: var(--s-5); border-top: 2px solid var(--mist); text-decoration: none; transition: border-color var(--t-base) var(--ease); }
  .cap:hover { border-top-color: var(--blue); }
  .cap :global(.cap-glyph) { color: var(--blue-ink); --glyph-node: var(--blue); }
  .cap h3 { font-size: var(--step-2); }
  .cap p { color: var(--ink-soft); }
  .rows { border-top: 1px solid var(--mist); }
  .rows.soon { margin-top: var(--s-7); }
  .rows li { border-bottom: 1px solid var(--mist); }
  .row { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 2fr); gap: var(--s-2) var(--s-6); align-items: center; padding: var(--s-5) 0; text-decoration: none; position: relative; }
  .row::before { content: ""; position: absolute; inset: 0 calc(-1 * var(--s-4)); background: color-mix(in srgb, var(--blue) 6%, transparent); opacity: 0; transition: opacity var(--t-base) var(--ease); pointer-events: none; }
  .row:hover::before, .row:focus-visible::before { opacity: 1; }
  .r-name { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.7rem; font-size: var(--step-2); font-weight: 700; font-stretch: 110%; letter-spacing: -0.02em; line-height: 1.15; transition: color var(--t-base) var(--ease); }
  .row:hover .r-name { color: var(--blue-ink); }
  .r-name :global(.r-glyph) { flex: none; color: var(--blue-ink); --glyph-node: var(--blue); }
  .r-text { color: var(--ink-soft); display: grid; gap: 0.2rem; }
  .r-model { font-size: var(--step--1); color: var(--ink-soft); opacity: 0.85; }
  .r-cta { font-weight: 650; color: var(--blue-ink); text-decoration: underline; text-underline-offset: 0.25em; text-decoration-thickness: 0.08em; justify-self: end; text-align: right; }
  .svc { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6) var(--s-8); margin-top: var(--s-8); border-top: 1px solid var(--night-line); padding-top: var(--s-6); }
  .svc h3 { color: var(--on-night); margin-bottom: var(--s-2); }
  .svc p { color: var(--on-night-soft); }
  .svc-cta { margin-top: var(--s-6); }
  @media (max-width: 62rem) {
    .triad { grid-template-columns: 1fr; gap: var(--s-6); }
    .row { grid-template-columns: 1fr; }
    .r-cta { justify-self: start; text-align: left; }
    .svc { grid-template-columns: 1fr; margin-top: var(--s-6); }
  }
  .head { display: grid; gap: var(--s-4); margin-bottom: var(--head-gap); max-width: 52rem; }
  .other { margin-top: var(--s-5); color: var(--ink-soft); }
  .other a { color: var(--blue-ink); font-weight: 600; }
  .trust { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-7); }
  .ico { color: var(--blue); margin-bottom: var(--s-3); }
  .trust h3 { margin-bottom: var(--s-2); }
  .trust p { color: var(--ink-soft); }
  .faq-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: start; }
  .faq-grid h2 { position: sticky; top: 6rem; }
  @media (max-width: 62rem) {
    .hero-grid, .faq-grid { grid-template-columns: 1fr; }
    .faq-grid h2 { position: static; }
        .trust { grid-template-columns: 1fr; gap: var(--s-6); }
  }
  @media (max-width: 62rem) {
    /* Móvil y tableta: titular, texto y botones, luego la demostración, y al final los datos de apoyo */
    .hero-copy { display: contents; }
    .hero-copy > * { grid-column: 1; }
    .hero-stage { order: 4; }
    .facts { order: 5; }
    .hero-grid { gap: var(--s-5); }
  }
  .l-short { display: none; }
  /* Botones: en una fila siempre que quepan; la medida la da el espacio de la columna, no la pantalla */
  .cta-wrap { container-type: inline-size; width: 100%; }
  @container (max-width: 31rem) {
    .cta-row { flex-wrap: nowrap; }
    .l-full { display: none; } .l-short { display: inline; }
  }
  @container (max-width: 24rem) {
    .cta-row { gap: var(--s-2); }
    .cta-row :global(.btn) { flex: 1 1 0; min-width: 0; padding: 0.8rem 0.6rem; font-size: 0.95rem; white-space: normal; text-align: center; }
  }
  @container (max-width: 17.5rem) { .cta-row { flex-direction: column; } }
  @media (max-width: 36rem) {
    .hero { padding-top: calc(4.25rem + 1.25rem); padding-bottom: 2.5rem; }
    .hero-grid { gap: var(--s-5); }
    .hero h1 { letter-spacing: -0.03em; line-height: 1.06; }
    .hero .lede { font-size: 1rem; line-height: 1.5; }
    /* Datos de apoyo: solo los títulos, en una lista compacta */
    .facts { gap: var(--s-2); padding-top: var(--s-4); }
    .facts dd { display: none; }
    .facts dt { display: flex; align-items: center; gap: 0.6rem; font-size: 0.92rem; }
    .facts dt::before { content: ""; width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--electric); flex: none; }
  }
</style>
