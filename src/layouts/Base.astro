---
import "@fontsource-variable/archivo/wdth.css";
import "../styles/base.css";
import fontLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import { SITE } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ChatWidget from "../components/ChatWidget.astro";

interface Props { title: string; description: string; path?: string; noindex?: boolean; chat?: boolean; darkHero?: boolean }
const { title, description, path = "", noindex = false, chat = true, darkHero = false } = Astro.props;
const canonical = `${SITE.url}${path}`;
const ld = {
  "@context": "https://schema.org",
  "@type": "Organization",
  logo: `${SITE.url}/icon-512-v5.png`,
  name: SITE.name,
  url: SITE.url,
  email: SITE.email,
  description,
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex" : "index,follow,max-image-preview:large"} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_MX" />
    <meta name="theme-color" content={darkHero ? "#060e2b" : "#f5f7fc"} />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192-v5.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-v5.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content="Reymen Solutions" />
    <meta name="apple-mobile-web-app-title" content="Reymen Solutions" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta property="og:site_name" content="Reymen Solutions" />
    <meta property="og:image" content={`${SITE.url}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Reymen Solutions" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}/og-image.png`} />
    {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
    <script is:inline>document.documentElement.classList.add("js");</script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {SITE.plausibleDomain && <link rel="preconnect" href="https://plausible.io" />}
    {SITE.plausibleDomain && <script defer data-domain={SITE.plausibleDomain} src="https://plausible.io/js/script.tagged-events.js"></script>}
    {SITE.plausibleDomain && <script is:inline>window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };</script>}
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <Header dark={darkHero} />
    <main id="main"><slot /></main>
    <Footer />
    {chat && <ChatWidget />}
    <script>
      // Revelado discreto de bloques que están más abajo; lo que ya se ve al cargar no se oculta (sin parpadeo)
      const targets = document.querySelectorAll<HTMLElement>(".section .head, .solutions li, .trust > div, .features > *, .faq-grid, .split > :last-child");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if ("IntersectionObserver" in window && !reduce) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
        targets.forEach((el, k) => {
          if (el.getBoundingClientRect().top < window.innerHeight * 0.95) return;
          el.setAttribute("data-reveal", ""); el.style.setProperty("--i", String(el.parentElement ? [...el.parentElement.children].indexOf(el) % 4 : 0)); io.observe(el);
        });
      }
    </script>
  </body>
</html>
