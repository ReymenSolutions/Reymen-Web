---
import "../styles/global.css";
import { SITE } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ChatWidget from "../components/ChatWidget.astro";

interface Props { title: string; description: string; path?: string; noindex?: boolean; chat?: boolean }
const { title, description, path = "", noindex = false, chat = true } = Astro.props;
const canonical = `${SITE.url}${path}`;
const ld = {
  "@context": "https://schema.org",
  "@type": "Organization",
  logo: `${SITE.url}/icon-512-v4.png`,
  name: SITE.name,
  url: SITE.url,
  email: SITE.email,
  description,
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_MX" />
    <meta name="theme-color" content="#0b1220" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192-v4.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-v4.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content="Reymen Solutions" />
    <meta name="apple-mobile-web-app-title" content="Reymen Solutions" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta property="og:site_name" content="Reymen Solutions" />
    <meta property="og:image" content={`${SITE.url}/icon-512-v4.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {SITE.plausibleDomain && <script defer data-domain={SITE.plausibleDomain} src="https://plausible.io/js/script.js"></script>}
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    {chat && <ChatWidget />}
  </body>
</html>
